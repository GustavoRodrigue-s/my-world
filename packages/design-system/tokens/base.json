      "$description": "rubrica — the brand red, by day",
      "$value": { "colorSpace": "srgb", "components": [0.7098, 0.1961, 0.1098], "hex": "#B5321C" }
    },
    "rubric-deep": {
      "$value": { "colorSpace": "srgb", "components": [0.5765, 0.149, 0.0588], "hex": "#93260F" }
    },
    "ember": {
      "$description": "brasa — the brand red lit up for night",
      "$value": { "colorSpace": "srgb", "components": [0.9333, 0.3608, 0.2471], "hex": "#EE5C3F" }
    },
    "ember-bright": {
      "$value": { "colorSpace": "srgb", "components": [1, 0.4941, 0.3843], "hex": "#FF7E62" }
    },
    "blueprint": {
      "$description": "cianotipia — blueprint blue",
      "$value": { "colorSpace": "srgb", "components": [0.1804, 0.2902, 0.4902], "hex": "#2E4A7D" }
    },
    "blueprint-night": {
      "$value": { "colorSpace": "srgb", "components": [0.5608, 0.651, 0.8392], "hex": "#8FA6D6" }
    },
    "gold": {
      "$description": "ouro velho — old gold",
      "$value": { "colorSpace": "srgb", "components": [0.4941, 0.3725, 0.1569], "hex": "#7E5F28" }
    },
    "gold-candle": {
      "$description": "gold by candlelight",
      "$value": { "colorSpace": "srgb", "components": [0.8314, 0.6863, 0.4157], "hex": "#D4AF6A" }
    },
    "graphite": {
      "$description": "grafite — pencil lead: achromatic, a cool sheen that sets it apart from warm muted ink",
      "$value": { "colorSpace": "srgb", "components": [0.3608, 0.3804, 0.4078], "hex": "#5C6168" }
    },
    "graphite-night": {
      "$value": { "colorSpace": "srgb", "components": [0.6392, 0.6588, 0.6863], "hex": "#A3A8AF" }
    },
    "$description": "The brand's chromatic colors, shared by every theme: themes extend base by pointing their roles at these (e.g. primary → {color.rubric}). Neutrals (paper, limewash, ink, night) belong to each theme's material and live there. Not emitted as CSS: components use the themes' roles."
