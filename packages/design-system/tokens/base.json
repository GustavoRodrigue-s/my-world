    "letter-spacing": {
      "$type": "number",
      "$description": "A fraction of the font size (0.1 = 10%), so it holds at any size; each platform applies it in its own unit (the web: em). Large grotesk sizes tighten inside the typography roles; mono labels open up.",
      "tighter": {
        "$value": -0.05
      },
      "tight": {
        "$value": -0.025
      },
      "normal": {
        "$value": 0
      },
      "wide": {
        "$value": 0.025
      },
      "wider": {
        "$value": 0.05
      },
      "widest": {
        "$value": 0.1
      }
    },
    "scale": {
      "$type": "number",
      "$description": "Sizes relative to the surrounding text (a fraction of its font size; the web writes them as em).",
      "emphasis": {
        "$description": "The emphasized word in the voice face next to a grotesk: Cormorant's small x-height needs it.",
        "$value": 1.08
      },
      "initial": {
        "$description": "The illuminated initial (drop capital).",
        "$value": 4.2
      },
      "initial-offset": {
        "$description": "How far the initial drops to sit on the first line.",
        "$value": 0.12
      },
      "baseline-shift": {
        "$description": "Lifts a dotted leader to sit on the text's baseline.",
        "$value": 0.3
      }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Text roles. fontSize is the largest size; letterSpacing is in px at that size (platforms scale it with the size). A role with a `world.responsive` extension starts at `base` and changes at each breakpoint it names, reaching fontSize at the next one (or xl), on platforms that can (elsewhere use fontSize).",
