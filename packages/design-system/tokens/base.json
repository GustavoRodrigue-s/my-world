      "$description": "A page's statement (its H1).",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": "{font.size.7xl}",
        "fontWeight": "{font.weight.semibold}",
        "lineHeight": "{font.line-height.none}",
        "letterSpacing": { "value": -3.6, "unit": "px" }
      },
      "$extensions": {
        "world.responsive": {
          "base": "{font.size.4xl}",
          "md": "{font.size.5xl}",
          "lg": "{font.size.7xl}"
        }
      }
    },
