{
  "$description": "Tokens every environment shares: near-square corners, the page's rhythm, the identity's three families, motion and stacking.",
  "radius": {
    "$type": "dimension",
    "$description": "Near-square corners: a technical drawing, not app chrome. rounded-xs is the default.",
    "xs": { "$value": { "value": 2, "unit": "px" } },
    "sm": { "$value": { "value": 3, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "lg": { "$value": { "value": 15, "unit": "px" } },
    "xl": { "$value": { "value": 20, "unit": "px" } },
    "2xl": { "$value": { "value": 30, "unit": "px" } },
    "pill": { "$value": { "value": 9999, "unit": "px" } },
    "card": { "$description": "The default card corner.", "$value": "{radius.xs}" }
  },
  "spacing": {
    "$type": "dimension",
    "content-max": { "$description": "Page width (.section-inner).", "$value": { "value": 1180, "unit": "px" } },
    "article-max": { "$description": "Reading width (.article-inner).", "$value": { "value": 720, "unit": "px" } },
    "section-x": { "$description": "Page gutter on phones.", "$value": { "value": 1.25, "unit": "rem" } },
    "section-x-md": { "$description": "Page gutter from 768px (applied in identity.css).", "$value": { "value": 2.5, "unit": "rem" } },
    "section-y": { "$description": "Vertical rhythm between sections on phones.", "$value": { "value": 80, "unit": "px" } },
    "section-y-md": { "$description": "Vertical rhythm from 768px (applied in identity.css).", "$value": { "value": 120, "unit": "px" } },
    "nav-h": { "$description": "Header height.", "$value": { "value": 64, "unit": "px" } }
  },
  "font": {
    "$type": "fontFamily",
    "$description": "Fallback stacks. The real families come from next/font variables on the environment's wrapper.",
    "sans": { "$description": "Bricolage Grotesque — headings and text.", "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"] },
    "serif": { "$description": "Cormorant Garamond — the voice: the one emphasized word, quotes, verses.", "$value": ["Cormorant Garamond", "Georgia", "serif"] },
    "mono": { "$description": "IBM Plex Mono — annotations: rubrics, captions, specs, dates.", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
  },
  "transition": {
    "$type": "transition",
    "$description": "Hovers are 150–200 ms: snappy, never decorative.",
    "fast": { "$value": { "duration": { "value": 150, "unit": "ms" }, "delay": { "value": 0, "unit": "ms" }, "timingFunction": [0.25, 0.1, 0.25, 1] } },
    "normal": { "$value": { "duration": { "value": 200, "unit": "ms" }, "delay": { "value": 0, "unit": "ms" }, "timingFunction": [0.25, 0.1, 0.25, 1] } },
    "slow": { "$value": { "duration": { "value": 300, "unit": "ms" }, "delay": { "value": 0, "unit": "ms" }, "timingFunction": [0.25, 0.1, 0.25, 1] } }
  },
  "z": {
    "$type": "number",
    "nav": { "$value": 100 },
    "modal": { "$value": 200 },
    "toast": { "$value": 300 }
  }
}
