{
  "$description": "Tokens every product of the brand shares — site, app, post, print. Values are written in the units a designer thinks in (px, ms); each platform's build converts them (the web turns sizes into rem).",
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "The identity's three voices. On the web, next/font loads the real files and overrides these stacks.",
      "sans": { "$description": "Bricolage Grotesque — headings and text.", "$value": ["Bricolage Grotesque", "system-ui", "sans-serif"] },
      "serif": { "$description": "Cormorant Garamond — the voice: the one emphasized word, quotes, verses.", "$value": ["Cormorant Garamond", "Georgia", "serif"] },
      "mono": { "$description": "IBM Plex Mono — annotations: labels, captions, specs, dates.", "$value": ["IBM Plex Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "The type scale. base is body text.",
      "2xs": { "$value": { "value": 10, "unit": "px" } },
      "xs": { "$value": { "value": 11, "unit": "px" } },
      "sm": { "$value": { "value": 13, "unit": "px" } },
      "md": { "$value": { "value": 14, "unit": "px" } },
      "base": { "$value": { "value": 15, "unit": "px" } },
      "lg": { "$value": { "value": 17, "unit": "px" } },
      "xl": { "$value": { "value": 19, "unit": "px" } },
      "2xl": { "$value": { "value": 22, "unit": "px" } },
      "3xl": { "$value": { "value": 24, "unit": "px" } },
      "4xl": { "$value": { "value": 28, "unit": "px" } },
      "5xl": { "$value": { "value": 32, "unit": "px" } },
      "6xl": { "$value": { "value": 40, "unit": "px" } },
      "7xl": { "$value": { "value": 54, "unit": "px" } },
      "8xl": { "$value": { "value": 76, "unit": "px" } },
      "9xl": { "$value": { "value": 88, "unit": "px" } }
    },
    "line-height": {
      "$type": "number",
      "compact": { "$description": "Display statements only.", "$value": 0.96 },
      "none": { "$value": 1 },
      "tight": { "$value": 1.05 },
      "snug": { "$value": 1.15 },
      "normal": { "$value": 1.3 },
      "relaxed": { "$description": "Body text.", "$value": 1.6 },
      "loose": { "$value": 2 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "$description": "Large grotesk sizes tighten; mono labels open up.",
      "tightest": { "$value": { "value": -0.04, "unit": "em" } },
      "tighter": { "$value": { "value": -0.03, "unit": "em" } },
      "tight": { "$value": { "value": -0.02, "unit": "em" } },
      "snug": { "$value": { "value": -0.01, "unit": "em" } },
      "normal": { "$value": { "value": 0, "unit": "em" } },
      "wide": { "$value": { "value": 0.02, "unit": "em" } },
      "wider": { "$value": { "value": 0.1, "unit": "em" } },
      "widest": { "$value": { "value": 0.16, "unit": "em" } }
    }
  },
  "typography": {
    "$type": "typography",
    "$description": "Text roles. A role with a `fluid` extension grows from `min` (small screens) to its fontSize (wide screens) on platforms that can; elsewhere use fontSize.",
    "display": {
      "$description": "A page's statement (its H1).",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.9xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.compact}", "letterSpacing": "{font.letter-spacing.tightest}" },
      "$extensions": { "world.fluid": { "min": "{font.size.6xl}" } }
    },
    "headline": {
      "$description": "A section's title.",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.7xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.tighter}" },
      "$extensions": { "world.fluid": { "min": "{font.size.5xl}" } }
    },
    "title": {
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.4xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.tight}" },
      "$extensions": { "world.fluid": { "min": "{font.size.2xl}" } }
    },
    "title-sm": {
      "$description": "An item's title in a list or a card.",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.snug}" }
    },
    "display-serif": {
      "$description": "The serif twins: same roles, set in the voice face (upright).",
      "$value": { "fontFamily": "{font.family.serif}", "fontSize": "{font.size.8xl}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.snug}" },
      "$extensions": { "world.fluid": { "min": "{font.size.6xl}" } }
    },
    "headline-serif": {
      "$value": { "fontFamily": "{font.family.serif}", "fontSize": "{font.size.7xl}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.snug}" },
      "$extensions": { "world.fluid": { "min": "{font.size.5xl}" } }
    },
    "title-serif": {
      "$value": { "fontFamily": "{font.family.serif}", "fontSize": "{font.size.5xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.snug}" },
      "$extensions": { "world.fluid": { "min": "{font.size.3xl}" } }
    },
    "title-sm-serif": {
      "$value": { "fontFamily": "{font.family.serif}", "fontSize": "{font.size.3xl}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.normal}" }
    },
    "quote": {
      "$description": "A quotation set large, in the voice face.",
      "$value": { "fontFamily": "{font.family.serif}", "fontSize": "{font.size.6xl}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.normal}" },
      "$extensions": { "world.fluid": { "min": "{font.size.4xl}" } }
    },
    "quote-sm": {
      "$description": "A quotation inside running text.",
      "$value": { "fontFamily": "{font.family.serif}", "fontSize": "{font.size.4xl}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.normal}" },
      "$extensions": { "world.fluid": { "min": "{font.size.2xl}" } }
    },
    "lead": {
      "$description": "The paragraph that opens a page or a section.",
      "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.2xl}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.letter-spacing.normal}" },
      "$extensions": { "world.fluid": { "min": "{font.size.xl}" } }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "The spacing scale: steps of 4px (space.N = N × 4px).",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "5": { "$value": { "value": 20, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } },
    "30": { "$value": { "value": 120, "unit": "px" } },
    "gutter": { "$description": "Side margin of the content on small screens.", "$value": "{space.5}" },
    "gutter-wide": { "$description": "Side margin from breakpoint.md.", "$value": "{space.10}" },
    "block": { "$description": "Distance between large blocks (a page's sections) on small screens.", "$value": "{space.20}" },
    "block-wide": { "$description": "Distance between large blocks from breakpoint.md.", "$value": "{space.30}" }
  },
  "size": {
    "$type": "dimension",
    "container": { "$description": "Widest content.", "$value": { "value": 1180, "unit": "px" } },
    "measure": { "$description": "Comfortable reading width for long text.", "$value": { "value": 720, "unit": "px" } },
    "bar": { "$description": "Height of a top bar (header).", "$value": { "value": 64, "unit": "px" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": { "value": 640, "unit": "px" } },
    "md": { "$description": "Where the layout opens up: gutter-wide, block-wide.", "$value": { "value": 768, "unit": "px" } },
    "lg": { "$value": { "value": 1024, "unit": "px" } },
    "xl": { "$value": { "value": 1280, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Near-square corners: a technical drawing, not app chrome.",
    "xs": { "$description": "The corner of every box.", "$value": { "value": 2, "unit": "px" } },
    "pill": { "$value": { "value": 9999, "unit": "px" } }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "hairline": { "$description": "Every rule and outline.", "$value": { "value": 1, "unit": "px" } }
    }
  },
  "opacity": {
    "$type": "number",
    "faint": { "$description": "A detail at rest that the reader's hand lights up (fillets).", "$value": 0.3 },
    "half": { "$value": 0.5 }
  },
  "duration": {
    "$type": "duration",
    "$description": "Hovers are 150–200 ms: snappy, never decorative. gesture is the brand objects' one longer move.",
    "fast": { "$value": { "value": 150, "unit": "ms" } },
    "normal": { "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$value": { "value": 300, "unit": "ms" } },
    "slower": { "$value": { "value": 500, "unit": "ms" } },
    "gesture": { "$value": { "value": 700, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.25, 0.1, 0.25, 1] },
    "out": { "$value": [0, 0, 0.2, 1] },
    "in-out": { "$value": [0.4, 0, 0.2, 1] }
  },
  "layer": {
    "$type": "number",
    "$description": "Stacking order.",
    "sticky": { "$value": 100 },
    "overlay": { "$value": 200 },
    "top": { "$value": 300 }
  }
}
