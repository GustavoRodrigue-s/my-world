{
  "blog": {
    "$description": "Blog — \"tinta e lápis\": the page of a book, ink for what is finished, graphite for what is still in pencil, and the one rubric red.",
    "light": {
      "$description": "Day. The only mode that prints.",
      "color": {
        "$type": "color",
        "surface": {
          "$description": "folha — the page of a book, a shade cooler than the portfolio's paper",
          "$value": { "colorSpace": "srgb", "components": [0.9373, 0.9294, 0.9059], "hex": "#EFEDE7" }
        },
        "surface-muted": {
          "$description": "Solid blocks and bands set apart from the page.",
          "$value": { "colorSpace": "srgb", "components": [0.8902, 0.8784, 0.8471], "hex": "#E3E0D8" }
        },
        "surface-raised": {
          "$description": "Floating panels: menus, dialogs, search.",
          "$value": { "colorSpace": "srgb", "components": [0.9686, 0.9647, 0.949], "hex": "#F7F6F2" }
        },
        "foreground": {
          "$description": "nanquim — ink: text and everything finished.",
          "$value": { "colorSpace": "srgb", "components": [0.0902, 0.0902, 0.102], "hex": "#17171A" }
        },
        "foreground-muted": {
          "$description": "Secondary text.",
          "$value": { "colorSpace": "srgb", "components": [0.3333, 0.3216, 0.298], "hex": "#55524C" }
        },
        "foreground-subtle": {
          "$description": "decoration only — below AA for small text",
          "$value": { "colorSpace": "srgb", "components": [0.5137, 0.502, 0.4784], "hex": "#83807A" }
        },
        "border": {
          "$description": "Hairlines.",
          "$value": { "colorSpace": "srgb", "components": [0.0902, 0.0902, 0.102], "alpha": 0.12 }
        },
        "border-strong": {
          "$description": "Rules that must be seen.",
          "$value": { "colorSpace": "srgb", "components": [0.0902, 0.0902, 0.102], "alpha": 0.28 }
        },
        "primary": {
          "$description": "rubrica — rubric red (the brand)",
          "$value": "{color.rubric}"
        },
        "primary-hover": {
          "$value": "{color.rubric-deep}"
        },
        "on-primary": {
          "$description": "Text on primary.",
          "$value": { "colorSpace": "srgb", "components": [0.9843, 0.9765, 0.9608], "hex": "#FBF9F5" }
        },
        "support": {
          "$description": "grafite — pencil: the note mark, margin notes, pencil underlines, the comments area; never running text",
          "$value": "{color.graphite}"
        },
        "hidden": {
          "$description": "ouro escondido — the Capela's gold, for one discreet detail (never a fill)",
          "$value": "{chapel.light.color.support}"
        },
        "shadow": {
          "$description": "Color of the one shadow (floating panels).",
          "$value": { "colorSpace": "srgb", "components": [0.0902, 0.0902, 0.102], "alpha": 0.1 }
        },
        "overlay": {
          "$description": "Dims the page behind a dialog.",
          "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.45 }
        }
      },
      "shadow": {
        "$type": "shadow",
        "floating": {
          "$description": "The one shadow: a floating panel.",
          "$value": {
            "color": "{blog.light.color.shadow}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 4, "unit": "px" },
            "blur": { "value": 20, "unit": "px" },
            "spread": { "value": 0, "unit": "px" }
          }
        }
      }
    },
    "dark": {
      "$description": "Night.",
      "color": {
        "$type": "color",
        "surface": {
          "$description": "lamparina — the reading room after hours, a shade cooler than the portfolio's night",
          "$value": { "colorSpace": "srgb", "components": [0.0745, 0.0784, 0.0863], "hex": "#131416" }
        },
        "surface-muted": {
          "$description": "Solid blocks and bands set apart from the page.",
          "$value": { "colorSpace": "srgb", "components": [0.1059, 0.1098, 0.1216], "hex": "#1B1C1F" }
        },
        "surface-raised": {
          "$description": "Floating panels: menus, dialogs, search.",
          "$value": { "colorSpace": "srgb", "components": [0.051, 0.0549, 0.0627], "hex": "#0D0E10" }
        },
        "foreground": {
          "$description": "Text and ink.",
          "$value": { "colorSpace": "srgb", "components": [0.9098, 0.902, 0.8824], "hex": "#E8E6E1" }
        },
        "foreground-muted": {
          "$description": "Secondary text.",
          "$value": { "colorSpace": "srgb", "components": [0.6314, 0.6196, 0.5922], "hex": "#A19E97" }
        },
        "foreground-subtle": {
          "$description": "Decoration only — below AA for small text.",
          "$value": { "colorSpace": "srgb", "components": [0.4196, 0.4118, 0.3922], "hex": "#6B6964" }
        },
        "border": {
          "$description": "Hairlines.",
          "$value": { "colorSpace": "srgb", "components": [0.9098, 0.902, 0.8824], "alpha": 0.11 }
        },
        "border-strong": {
          "$description": "Rules that must be seen.",
          "$value": { "colorSpace": "srgb", "components": [0.9098, 0.902, 0.8824], "alpha": 0.26 }
        },
        "primary": {
          "$description": "brasa — the rubric lit up for night",
          "$value": "{color.ember}"
        },
        "primary-hover": {
          "$value": "{color.ember-bright}"
        },
        "on-primary": {
          "$description": "Text on primary.",
          "$value": "{blog.dark.color.surface}"
        },
        "support": {
          "$description": "grafite — pencil: the note mark, margin notes, pencil underlines, the comments area; never running text",
          "$value": "{color.graphite-night}"
        },
        "hidden": {
          "$description": "A detail hidden on the page, revealed only up close. Never a fill.",
          "$value": "{chapel.dark.color.support}"
        },
        "shadow": {
          "$description": "Color of the one shadow (floating panels).",
          "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 }
        },
        "overlay": {
          "$description": "Dims the page behind a dialog.",
          "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.45 }
        }
      },
      "shadow": {
        "$type": "shadow",
        "floating": {
          "$description": "The one shadow: a floating panel.",
          "$value": {
            "color": "{blog.dark.color.shadow}",
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 4, "unit": "px" },
            "blur": { "value": 20, "unit": "px" },
            "spread": { "value": 0, "unit": "px" }
          }
        }
      }
    }
  }
}
